# Data - MRI volumes, PHI, de-identified patient data
data/**/*.nii
data/**/*.nii.gz
data/**/*.mgz
data/**/*.mha
data/**/*.mhd
data/**/*.raw
data/**/*.dcm
data/raw/
data/nifti/
data/processed/
# OpenNeuro ds004199 is public CC0, but large. Keep the local dataset out of git.
data/openneuro/ds004199/
# keep notes and keepfiles tracked
!data/README.md
!data/.gitkeep

# Outputs - generated volumes, heatmaps, PNGs; regenerable locally
# Allow index.json and manifest.json to be committed for viewer bootstrap
outputs/
!outputs/.gitkeep
!outputs/end_to_end/index.json
!outputs/end_to_end/*/manifest.json
dist/

