{
  "name": "isu-brain-visualizer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:js && npm run test:python",
    "test:python": "python -m pytest -q",
    "test:js": "node --test tests/*.test.mjs",
    "test:js:coverage": "node --experimental-test-coverage --test tests/*.test.mjs",
    "test:viewer": "npm run test:js",
    "test:viewer:coverage": "npm run test:js:coverage",
    "test:viewer:static": "python -m pytest tests/test_viewer_app_static.py tests/test_viewer_static.py tests/test_viewer_splat_static.py tests/test_viewer_splat_renderer.py tests/test_verify_viewer_dataset.py -q",
    "test:python:coverage": "python -m pytest --cov=src/fcd_prototype --cov-report=term-missing:skip-covered --cov-fail-under=90 -q",
    "verify:viewer-data": "python scripts/verify_viewer_dataset.py",
    "start": "python scripts/run_viewer.py"
  }
}
